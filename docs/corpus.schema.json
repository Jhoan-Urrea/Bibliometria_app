{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bibliometria.example/schemas/corpus.schema.json",
  "title": "Bibliometria corpus",
  "description": "Bibliographic corpus records from a manifest with explicit human-review status.",
  "type": "array",
  "minItems": 20,
  "maxItems": 20,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "filename",
      "sha256",
      "title",
      "authors",
      "abstractText",
      "language",
      "paginaAbstract",
      "verified",
      "verificadoPor",
      "notas"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^A[0-9]{2}$"
      },
      "filename": {
        "type": "string",
        "minLength": 1
      },
      "sha256": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{64}$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "authors": {
        "type": "string",
        "minLength": 1
      },
      "abstractText": {
        "type": "string",
        "minLength": 100
      },
      "language": {
        "type": "string",
        "minLength": 2
      },
      "paginaAbstract": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "verified": {
        "type": "boolean"
      },
      "verificadoPor": {
        "type": "string",
        "minLength": 1
      },
      "notas": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "verified": {
              "const": true
            }
          },
          "required": [
            "verified"
          ]
        },
        "then": {
          "properties": {
            "verificadoPor": {
              "not": {
                "const": "PENDIENTE_REVISION_HUMANA"
              }
            },
            "notas": {
              "not": {
                "contains": {
                  "const": "AWAITING_MANUAL_DOUBLE_REVIEW"
                }
              }
            }
          }
        }
      }
    ]
  }
}
